# Local server-side configuration. Never use VITE_ prefixes for credentials.
GOOGLE_APPLICATION_CREDENTIALS=.secrets/gsc-service-account.json
GSC_PROPERTY=sc-domain:boonts.com
YANDEX_WEBMASTER_API_URL=https://api.webmaster.yandex.net/v4/
YANDEX_WEBMASTER_CLIENT_ID=
YANDEX_WEBMASTER_CLIENT_SECRET=
YANDEX_WEBMASTER_OAUTH_TOKEN=
YANDEX_WEBMASTER_REFRESH_TOKEN=
# Optional, separate from the service account:
GOOGLE_API_KEY=
GA4_PROPERTY_ID=
